+" <SID> in a replayed {rhs} must point to the script that defined the mapping
+function! s:ResolveSid(mapping)
+    if get(a:mapping, 'sid', 0) <= 0
+        return a:mapping.rhs
+    endif
+    return substitute(a:mapping.rhs, '\c<SID>', '<SNR>' . a:mapping.sid . '_', 'g')
+endfunction
+
+function! s:RunCallback(callback_key)
+    call call(s:callbacks[a:callback_key], [])
+endfunction
+
+" Mapping mode the wrapping <expr> mapping is evaluated in
+function! s:MapMode()
+    let current = mode(1)
+    if current =~# '^no'
+        return 'o'
+    elseif current =~# "^[vV\<C-V>]"
+        return 'x'
+    endif
+    return 'n'
+endfunction
+
+" The wrapped mapping of {lhs} for one mapping mode, or the built-in command
+function! s:CaptureMapping(lhs, mode)
+    let maparg = maparg(a:lhs, a:mode, 0, 1)
+    if empty(maparg)
+        return { 'lhs': a:lhs, 'rhs': a:lhs, 'noremap': 1, 'expr': 0 }
+    endif
+    if get(maparg, 'sid', 0) == s:sid_nr
+        " Already wrapped globally, take over the mapping the global wrapper replays
+        for m in s:repeatable_motions
+            for dir in ['backwards', 'forwards']
+                if s:NormalizeMotion(m[dir].lhs) ==# s:NormalizeMotion(a:lhs)
+                    return m[dir].modes[a:mode]
+                endif
+            endfor
+        endfor
+    endif
+    return maparg
+endfunction
+
+function! s:CaptureModes(lhs)
+    return { 'n': s:CaptureMapping(a:lhs, 'n'), 'x': s:CaptureMapping(a:lhs, 'x'), 'o': s:CaptureMapping(a:lhs, 'o') }
+endfunction
+
+function! s:WrapperMapCommand(maparg)
+    let mapstring = 'noremap <expr>'
+    if a:maparg.buffer
+        let mapstring .= ' <buffer>'
+    endif
+    if a:maparg.silent
+        let mapstring .= ' <silent>'
+    endif
+    return mapstring
+endfunction
